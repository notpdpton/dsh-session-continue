{
  "name": "dsh-session-continue",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "description": "会话非正常结束时，在输入框上方显示提示与「继续」按钮。",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "recovery",
    "continue"
  ],
  "license": "MIT",
  "engines": {
    "dsh": "^0.2.1-rc.5"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./index.js": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs/*.md"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "dependencies": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}